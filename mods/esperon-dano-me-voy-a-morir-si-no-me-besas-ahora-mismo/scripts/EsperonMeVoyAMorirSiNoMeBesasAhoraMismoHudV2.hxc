import funkin.play.PlayState;

/**
 * HUD visual V2 para Me Voy A Morir Si No Me Besas Ahora Mismo.
 * Solo recoloriza la barra de vida al inicio del conteo.
 * No modifica audio, BPM, offsets, chart, notas ni eventos musicales.
 */
class EsperonMeVoyAMorirSiNoMeBesasAhoraMismoHudV2 extends Module
{
  function new()
  {
    super("Esperón HUD — Me Voy A Morir Si No Me Besas Ahora Mismo", 1, {state: PlayState});
  }

  override function onCountdownStart(event)
  {
    super.onCountdownStart(event);
    if (PlayState.instance == null || PlayState.instance.healthBar == null) return;
    if (PlayState.instance.iconP1 == null) return;
    if (PlayState.instance.iconP1.characterId != "esperon-me-voy-a-morir-si-no-me-besas-ahora-mismo") return;
    PlayState.instance.healthBar.createFilledBar(0xFFDDB75F, 0xFF9C42E0);
    PlayState.instance.healthBar.updateBar();
  }
}
